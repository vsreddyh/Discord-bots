# ─────────────────────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH — every env var for the whole stack lives in
# this one file. Copy it to `.env` and fill in real values. There are
# NO per-profile `.env` files anymore; docker-compose maps these vars
# into each service as needed.
# ─────────────────────────────────────────────────────────────────────

# ── Environment: prod = remote MongoDB, dev = temporary local MongoDB ──
# prod (or unset) → MONGODB_URI as-is (remote Atlas, hermes DB).
# dev → temporary local mongodb container (mongodb:27017, ephemeral).
# The live machine keeps prod; dev machines set dev. Set only here, in the root .env.
HERMES_ENV=prod

# ── LLM Provider API Keys ─────────────────────────────────────────────
OPENCODE_ZEN_API_KEY=sk-...            # OpenCode Zen (direct, no proxy) — also used as HERMES_API_KEY via compose

# ── Discord: one token + home channel per profile (story, resumes, default-god) ─
DISCORD_BOT_TOKEN_STORY=...
DISCORD_BOT_TOKEN_RESUMES=...
DISCORD_BOT_TOKEN_DEFAULT=...
DISCORD_HOME_CHANNEL_STORY=1523762320986214541
DISCORD_HOME_CHANNEL_RESUMES=1536259587152543825
DISCORD_HOME_CHANNEL_DEFAULT=1535611174039719976
# Retired: DISCORD_BOT_TOKEN_MONEY/_FOOD + DISCORD_HOME_CHANNEL_MONEY/_FOOD —
# money/food are now MCPs on the default profile. Reuse one of the old
# money/food tokens + channels for DISCORD_BOT_TOKEN_DEFAULT/_CHANNEL_DEFAULT.
# Allow messages from any user (true) or only DISCORD_ALLOWED_USERS
DISCORD_ALLOW_ALL_USERS=true
# DISCORD_ALLOWED_USERS=user1,user2

# ── Dashboard (gateway home, supervised by s6 alongside gateway) ───────
# HERMES_DASHBOARD=1 runs dashboard in the SAME gateway container (mirrors
# official nousresearch/hermes-agent: HERMES_DASHBOARD=1 enables the dashboard
# s6 service). Set to 0 to disable.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
# Stable token-signing secret (32+ bytes, base64/hex/raw). Unset = sessions
# die on every dashboard restart.
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Nutrition lookups ────────────────────────────────────────────
# Retired: USDA_API_KEY (food MCP did USDA lookups; health-check takes
# user-supplied macros only).

# ── SearXNG ────────────────────────────────────────────────────────────
# SEARXNG_PORT=8888            # override (compose default: 8888)
# SEARXNG_HOSTNAME=localhost   # override (compose default: localhost)
SEARXNG_SECRET_KEY=change-me

# ── Health Connect sync endpoint token (Android app) ──────────────────
HEALTH_SYNC_TOKEN=change-me

# ── Workspace repos (git-backed bot workspaces, cloned by init) ──────────
# story bot lore vault → workspace/portals
# HERMES_PORTALS_REPO=git@github.com:vsreddyh/portals.git
# resumes bot workspace/repo → workspace/resumes (bot cwd IS the repo)
# HERMES_RESUMES_REPO=git@github.com:vsreddyh/Resume.git

# ── Remote MongoDB (prod: money/health/cookbook domain data) ───────
# In dev (HERMES_ENV=dev) this is IGNORED — a temporary local mongodb
# container is used instead (mongodb://mongodb:27017, ephemeral, no volume).
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/
MONGODB_DB=hermes

# ── Money MCP ────────────────────────────────────────────────────
# Default account for log_transaction/log_text when no account is given.
MONEY_DEFAULT_ACCOUNT=Cash

# ── DeepInfra ────────────────────────────────────────────────────────
# Fallback provider (deepseek-ai/DeepSeek-V4-Flash-0731) + image gen
DEEPINFRA_API_KEY=
