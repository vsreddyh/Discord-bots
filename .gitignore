# ────────────────────────────────────────────────────────
# Environment — track .env.example, NEVER commit .env
# ────────────────────────────────────────────────────────
.env
!.env.example

# ────────────────────────────────────────────────────────
# Docker
# ────────────────────────────────────────────────────────
docker/.env
!docker/.env.example

# ────────────────────────────────────────────────────────
# Runtime (PIDs, logs, venvs for native zen-proxy / health-api / bots)
# ────────────────────────────────────────────────────────
run/

# ────────────────────────────────────────────────────────
# Workspace (per-bot cwd, host-only)
# ────────────────────────────────────────────────────────
workspace/

# ────────────────────────────────────────────────────────
# Bot profiles — secrets live in per-profile .env, never commit
# ────────────────────────────────────────────────────────
profiles/*/.env
!profiles/*/.env.example

# Rendered config (hermes reads config.yaml; the committed source is
# config.yaml.template) — never commit
profiles/*/config.yaml
profiles/*/config.rendered.yaml

# Per-profile runtime state (written by the gateways) — never commit
profiles/*/.cache/
profiles/*/.local/
profiles/*/.skills_prompt_snapshot.json
profiles/*/auth.lock
profiles/*/audio_cache/
profiles/*/bin/
profiles/*/cache/
profiles/*/channel_directory.json
profiles/*/cron/
profiles/*/gateway*
profiles/*/hooks/
profiles/*/image_cache/
profiles/*/kanban/
profiles/*/kanban.db*
profiles/*/logs/
profiles/*/memories/
profiles/*/pairing/
profiles/*/platforms/
profiles/*/sessions/
profiles/*/state/
profiles/*/state.db*
profiles/*/sandboxes/
profiles/*/data/
profiles/*/.clean_shutdown
profiles/*/config.rendered.yaml

# Hermes skill CONTENT (incl. autogenerated + nousresearch/ packs) IS committed.
# Only per-bot bookkeeping files stay ignored:
profiles/*/skills/.usage.json*
profiles/*/skills/.curator_state

# ────────────────────────────────────────────────────────
# Android app (health-gateway)
# ────────────────────────────────────────────────────────
android/health-gateway/.gradle/
android/health-gateway/build/
android/health-gateway/app/build/
android/health-gateway/local.properties
android/health-gateway/.kotlin/
*.apk

# ────────────────────────────────────────────────────────
# OS / Editor
# ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.pyc
__pycache__/
