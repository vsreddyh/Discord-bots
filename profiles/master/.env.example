# Master bot (coordinator) — secrets, git-ignored.
HERMES_API_KEY=zen-proxy
DISCORD_BOT_TOKEN=
DISCORD_HOME_CHANNEL=
DISCORD_ALLOW_ALL_USERS=true

# Hermes web dashboard — binds 0.0.0.0:$HERMES_DASHBOARD_PORT; password required.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
# Stable token-signing secret (32+ bytes, base64/hex/raw). Unset = sessions
# die on every dashboard restart.
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=
